<?xml version="1.0"?>
<!--
  The robot as PHYSICS: masses, wheels that touch the ground, friction that can
  run out. Contrast robot_sim/world.py, which is the same robot as kinematics.

  ⚠️ THE MODEL FRAME IS AT GROUND LEVEL, between the two wheel contact patches.
  Every <pose> below is measured from there, so the model spawns standing on the
  ground at whatever pose `ros_gz_sim create` is given.

  ⚠️ A LINK WITH NO <pose> SITS AT THE MODEL ORIGIN, and a joint's <pose> does
  NOT move its child. Both wheels used to have no pose: two coincident discs
  buried inside the base_link box, touching nothing. Gazebo still drove them —
  DiffDrive velocity-controls the joints whether or not they carry any load —
  and still published odometry, because DiffDrive's odometry is dead reckoning
  from the wheel joint angles. Measured on that model: /odometry read 5.47 m
  while the true pose read 3.8e-9 m. The robot had not moved at all and nothing
  anywhere reported a problem. That is why ground truth here comes from
  OdometryPublisher and never from DiffDrive.
-->
<sdf version="1.9">
  <model name="hoverbot">
    <static>false</static>

    <!-- Chassis. 15 kg, box inertia worked out by hand from the 0.7 x 0.5 x
         0.18 body: Ixx = m/12 (y^2+z^2) = 1.25 * (0.25+0.0324) = 0.353,
         Iyy = 1.25 * (0.49+0.0324) = 0.653, Izz = 1.25 * (0.49+0.25) = 0.925.
         The default <inertia> of 1/1/1 was three guesses in a trench coat and
         it set the load transfer that decides how much the wheels can slip. -->
    <link name="base_link">
      <pose>0 0 0.18 0 0 0</pose>
      <inertial>
        <mass>15</mass>
        <inertia><ixx>0.353</ixx><iyy>0.653</iyy><izz>0.925</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.7 0.5 0.18</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.7 0.5 0.18</size></box></geometry>
      </visual>

      <!-- Casters as low-friction spheres rigidly attached to the chassis, not
           as swivelling links. A free castor wheel is a two-joint mechanism
           that adds its own dynamics (and its own way of falling over) to model
           something whose only job here is "holds the front up and does not
           resist turning". Radius 0.045 at z = 0.045 above the ground, so the
           chassis sits level on four contact points — the 4-point static
           platform of handoff decision 1.
           Their mass is inside the 15 kg; they carry no separate <inertial>. -->
      <collision name="caster_front">
        <pose>0.28 0 -0.135 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_front_visual">
        <pose>0.28 0 -0.135 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
      </visual>
      <collision name="caster_rear">
        <pose>-0.28 0 -0.135 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_rear_visual">
        <pose>-0.28 0 -0.135 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
      </visual>

      <!-- The collision oracle, and ONLY the box: the casters and the wheels
           touch the ground on every single step, so a sensor that watched them
           would report "in contact" forever. The chassis box has 9 cm of
           ground clearance, so anything it touches is something the robot ran
           into. sim_node republishes this as /collision_truth — the same oracle
           KinematicWorld provides from its own collision flag. -->
      <sensor name="chassis_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/model/hoverbot/contacts</topic>
        <contact><collision>collision</collision></contact>
      </sensor>
    </link>

    <!-- Wheels. Cylinder geometry runs along its own +Z, so the link is rolled
         -90 deg about X to lay it on its side; the joint axis is then 0 0 1 IN
         THE CHILD LINK FRAME, which is +Y in the model. Cylinder inertia by
         hand for m=1, r=0.0825, L=0.04:
           Izz (spin axis) = m r^2 / 2                 = 0.0034031
           Ixx = Iyy = m (3 r^2 + L^2) / 12            = 0.0018349 -->
    <link name="left_wheel">
      <pose>0 0.25 0.0825 -1.5707963 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.0018349</ixx><iyy>0.0018349</iyy><izz>0.0034031</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry>
        <!-- ⚠️ THIS NUMBER DECIDES HOW MUCH THE ROBOT SLIPS, so it is stated
             here rather than left to the engine's default of 1.0 (dry rubber on
             asphalt — not where this robot lives). 0.5 is rubber on packed
             grass/dirt; like robot_radius it is a documented guess until the
             chassis exists. test_gazebo_physics.py pins the slip it implies. -->
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry>
      </visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.25 0.0825 -1.5707963 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia><ixx>0.0018349</ixx><iyy>0.0018349</iyy><izz>0.0034031</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- What the WHEELS say. DiffDrive dead-reckons this from the wheel joint
         angles, exactly like the hall sensors on the real board, so it keeps
         reporting travel while the wheels spin on the spot. GazeboBackend turns
         it back into hall units; it is NOT ground truth and must never be used
         as such. See the warning at the top of this file. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.0825</wheel_radius>
      <topic>/model/hoverbot/cmd_vel</topic>
      <odom_topic>/model/hoverbot/wheel_odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- What the WORLD says. OdometryPublisher differentiates the model's true
         pose, so the gap between this and the plugin above IS the wheel slip —
         the one thing the kinematic world cannot produce. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>sim_world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/hoverbot/ground_truth</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
