<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hoverbot">
    <static>false</static>
    <link name="base_link">
      <inertial><mass>15</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.7 0.5 0.18</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.7 0.5 0.18</size></box></geometry></visual>
    </link>
    <link name="left_wheel">
      <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="right_wheel">
      <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.0825</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis>
      <pose>0 0.25 -0.09 1.5708 0 0</pose>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis>
      <pose>0 -0.25 -0.09 1.5708 0 0</pose>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.0825</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>