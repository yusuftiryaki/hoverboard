<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_sim</name>
  <version>0.1.0</version>
  <description>
    Hardware-free simulated world for the robot. Drives hoverboard_bridge's
    Esp32Sim brain with a kinematic backend or Gazebo Sim physics backend.
    The real bridge, binary protocol and safety logic stay in the loop.
  </description>
  <maintainer email="enesis@entes.com.tr">Enes</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>hoverboard_bridge</exec_depend>
  <!-- For earth_field: the simulated magnetic field has ONE definition, and it
       lives with the magnetometer driver. See A6 in docs/handoff.md. -->
  <exec_depend>qmc5883l_driver</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
